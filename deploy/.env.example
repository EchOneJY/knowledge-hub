# ============================================================
# Knowledge Hub 部署配置
# 复制为 deploy/.env 后按实际情况填写
# ============================================================

# --- 部署目标（仅 deploy.sh 使用） ---
DEPLOY_HOST=101.43.44.95
DEPLOY_USER=root
DEPLOY_DIR=/opt/knowledge-hub

# --- 对外端口 ---
FRONTEND_PORT=5175
API_PORT=3001

# --- 前端产物选择：react-app 或 vue-app ---
FRONTEND_APP=react-app

# --- 镜像标签（deploy.sh 自动生成，一般不需要手动设置） ---
# IMAGE_TAG=20260917-120000

# --- 后端端口 ---
PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=user
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=knowledge_hub
# 仅绑服务器本机(127.0.0.1),需 SSH 隧道访问
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_USER=mongo_user
MONGO_PASSWORD=请改成强密码
MONGO_PORT=27017

# --- Redis ---
REDIS_PASSWORD=请改成强密码
REDIS_DB=0
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=请改成强密码
RABBITMQ_MGMT_PORT=15672

# --- Elasticsearch ---
ES_PORT=9201

# --- RustFS ---
RUSTFS_ENABLED=true
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=请改成强密码
RUSTFS_BUCKET=knowledge-hub
RUSTFS_REGION=us-east-1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# 留空表示不通过公网暴露文件预览；如需浏览器直接访问文件，填 http://101.43.44.95:9000
RUSTFS_PUBLIC_URL=

# --- Neo4j ---
NEO4J_ENABLED=true
NEO4J_PASSWORD=请改成强密码
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- 雪花 ID ---
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_OFFSET=1704067200000

# --- RAG 配置 ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_HYBRID_TOP_K=10
RAG_RRF_C=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3.7-text-rerank
RAG_MIN_SCORE=0

# --- Embedding ---
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BATCH_SIZE=10
# 填入 DashScope API Key（或通用 OpenAI 兼容 Key）
EMBEDDING_API_KEY=

# --- Rerank ---
RERANK_BASE_URL=https://dashscope.aliyuncs.com
# 如与 EMBEDDING_API_KEY 相同可留空，代码会回退读取 OPENAI_API_KEY
RERANK_API_KEY=

# --- LLM 抽取 / AI 对话 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.8-flash
KG_LLM_TIMEOUT_MS=60000
AI_CHAT_TIMEOUT_MS=60000
LLM_ENABLE_THINKING=true

# --- 联网搜索（Bocha） ---
BOCHA_API_KEY=

# --- JWT ---
JWT_SECRET=请改成足够长的随机字符串
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# --- 邮箱 ---
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://101.43.44.95:5175
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Knowledge Hub <你的邮箱>"

# --- 对话记忆 ---
CHAT_SHORT_MEMORY_TTL_SECONDS=3600
CHAT_SHORT_MEMORY_MAX_MESSAGES=20
CHAT_SHORT_MEMORY_KEY_PREFIX=chat:short:
AI_QUERY_REWRITE_TIMEOUT_MS=5000

# --- Mem0 长期记忆（可选） ---
MEM0_API_KEY=
MEM0_HOST=https://api.mem0.ai
MEM0_TOP_K=5

# --- LangSmith 追踪（可选） ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-hub

# --- 文档发布审核 ---
DOCUMENT_REQUIRE_APPROVAL=false

# --- 时区 ---
TZ=Asia/Shanghai
